FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_LIB_PATH=/app/.simulation_toolkits

ARG REPO_URL=https://github.com/likooooo/simulation_toykits.git
ARG ARTIFACTS_REPO=likooooo/simulation_toolkits_artifacts
ARG ARTIFACT_NAME=simulation_toolkits-linux-x86_64.tar.gz
ARG BUILD_TIME=""

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    python3 python3-dev python3-venv \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 "${REPO_URL}" . \
    && git rev-parse HEAD \
    && rm -rf .git

RUN set -eux; \
    ASSET_URL=$(curl -fsSL "https://api.github.com/repos/${ARTIFACTS_REPO}/releases/latest" \
      | python3 -c "import json,sys; name='${ARTIFACT_NAME}'; assets=json.load(sys.stdin).get('assets',[]); print(next(a['browser_download_url'] for a in assets if a['name']==name))"); \
    curl -fsSL -o /tmp/artifact.tar.gz "${ASSET_URL}"; \
    tar -xzf /tmp/artifact.tar.gz -C /app; \
    rm /tmp/artifact.tar.gz; \
    test -f /app/.simulation_toolkits/simulation.so

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

ENV PYTHONPATH="/app:${APP_LIB_PATH}:${PYTHONPATH}" \
    LD_LIBRARY_PATH="${APP_LIB_PATH}:${LD_LIBRARY_PATH}" \
    SIMULATION_ARTIFACTS_DIR="${APP_LIB_PATH}" \
    SIMULATION_DATABASE_DIR=/app/.simulation_toolkits/assets

RUN echo "${APP_LIB_PATH}" > /etc/ld.so.conf.d/99-app-libs.conf && ldconfig

EXPOSE 7860

CMD ["sh", "-c", "exec streamlit run app.py --server.port=7860 --server.address=0.0.0.0 --server.enableCORS=false --server.enableXsrfProtection=false --client.toolbarMode=minimal"]
