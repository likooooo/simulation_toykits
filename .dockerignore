# 减小构建上下文；运行时必需路径用 ! 保留
.git
.gitignore
.gitmodules
.github
.cursor
*.pyc
__pycache__
.pytest_cache
.mypy_cache
*.egg-info
.env
env
.venv
venv
dist
agent
test
scripts
*.md
!docs/**
!README.MD
.dockerignore
Dockerfile.hugging_face

# simulation_core：仅保留 database 与 infrastructure/requirements.txt
simulation_core/build
simulation_core/tests
simulation_core/src
simulation_core/scripts
simulation_core/3rdparty
!simulation_core/3rdparty/infrastructure/requirements.txt
simulation_core/assets/*
!simulation_core/assets/database/**

# .simulation_core 默认排除后显式纳入
.simulation_core
!.simulation_core/**
